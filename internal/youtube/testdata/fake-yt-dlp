#!/bin/sh
# Stands in for yt-dlp in tests: records its arguments, replays a fixture.
# FAKE_YTDLP_OUTPUTS (space-separated) replays one file per call, in order.
printf '%s\n' "$@" >> "$FAKE_YTDLP_ARGS"
echo "--" >> "$FAKE_YTDLP_ARGS"
if [ -n "$FAKE_YTDLP_FAIL" ]; then
	echo "ERROR: [youtube] sign in to confirm you're not a bot" >&2
	exit 1
fi
if [ -n "$FAKE_YTDLP_OUTPUTS" ]; then
	n=$(grep -c '^--$' "$FAKE_YTDLP_ARGS")
	set -- $FAKE_YTDLP_OUTPUTS
	shift $((n - 1))
	cat "$1"
	exit 0
fi
cat "$FAKE_YTDLP_OUTPUT"
